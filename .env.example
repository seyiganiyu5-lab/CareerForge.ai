# Copy this file to .env and fill in your own values. Never commit .env.

# Database (SQLite file for local development)
DATABASE_URL="file:../db/custom.db"

# Public URL of the site (used for OAuth and email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth — use a long random string, e.g. `openssl rand -base64 32`
JWT_SECRET=""
PASSWORD_SALT=""

# Google sign-in (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments (Flutterwave dashboard → Settings → API keys / Webhooks)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_SECRET=""

# Email (set one)
RESEND_API_KEY=""
BREVO_API_KEY=""

# Supabase (newsletter)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
