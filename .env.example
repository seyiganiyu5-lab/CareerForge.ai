# Copy this file to .env and fill in your own values. Never commit .env.
# On Vercel, add the same values under Settings → Environment Variables.

# Public URL of the site (used in email and Google sign-in links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase project (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only key used to delete accounts (Supabase → Project Settings → API Keys →
# "service_role" / secret key). Never share it or put it in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=""

# Database — Supabase Postgres (Supabase → Connect → ORMs → Prisma)
# Pooled connection (port 6543), used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used to create/update tables
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# AI — any OpenAI-compatible service. Default is Google Gemini (free plan):
# get a key at https://aistudio.google.com → "Get API key".
# To switch provider later, change these three lines (e.g. Claude, OpenAI, Groq).
AI_API_KEY=""
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
AI_MODEL="gemini-3.8-flash"
# Backup model(s) used when the main one is busy (comma-separated, "" for none)
AI_FALLBACK_MODELS="gemini-3.5-flash"

# Payments — Paystack (dashboard → Settings → API Keys & Webhooks). See PAYMENTS.md.
# Use the TEST secret key (sk_test_...) until you are ready for real payments.
# Server-only: never put it in a NEXT_PUBLIC_ variable or share it.
PAYSTACK_SECRET_KEY=""
# Currencies your Paystack account accepts: NGN, USD (after Paystack approves
# international payments), XOF (businesses registered in Côte d'Ivoire)
PAYMENT_CURRENCIES="NGN,USD"

# Job tracker: automatic email forwarding (optional; see integrations/cloudflare-email-worker)
# Users forward job emails to track-<code>@INBOUND_EMAIL_DOMAIN. Leave empty to turn it off.
INBOUND_EMAIL_DOMAIN=""
# Shared with the Cloudflare Email Worker so only it can post emails to the app
INBOUND_EMAIL_SECRET=""
