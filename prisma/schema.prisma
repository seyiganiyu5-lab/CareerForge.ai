generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @default(cuid())  // Same id as the Supabase Auth user
  email                 String    @unique
  inbound_email_token   String?   @unique // personal address for forwarding job emails
  first_name            String?
  last_name             String?
  auth_provider         String    @default("email")
  google_id             String?   @unique
  google_picture_url    String?
  country               String?
  job_title             String?
  career_level          String?
  career_goal           String?
  language              String    @default("en")
  theme                 String    @default("system")
  email_verified        Boolean   @default(false)
  onboarding_completed  Boolean   @default(false)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  subscription   Subscription?
  usage          UserUsage?
  payments       Payment[]
  resumes        Resume[]
  coverLetters   CoverLetter[]
  aiHistory      AiHistory[]
  jobApplications JobApplication[]
  notifications  Notification[]
  organizationMembership OrganizationMember?
}

model Plan {
  id            String   @id @default(cuid())
  name          String   @unique              // free, pro, enterprise
  display_name  String                        // Free, Pro, Enterprise
  price_monthly Int      @default(0)
  price_yearly  Int      @default(0)
  currency      String   @default("USD")
  billing_cycle String   @default("monthly")  // monthly, yearly
  features      String   @default("[]")        // JSON array of feature keys
  description   String   @default("")
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  subscriptions Subscription[]
  plan_features PlanFeature[]
  prices        PlanPrice[]
}

// Price of a paid plan in one currency, in the currency's subunit (x100)
model PlanPrice {
  id            String   @id @default(cuid())
  plan_id       String
  currency      String                         // NGN, USD, XOF
  price_monthly Int
  price_yearly  Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  plan Plan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, currency])
}

model PlanFeature {
  id          String   @id @default(cuid())
  plan_id     String
  feature_key String
  enabled     Boolean  @default(true)
  limit_value Int      @default(-1)  // -1 = unlimited
  created_at  DateTime @default(now())

  plan Plan @relation(fields: [plan_id], references: [id], onDelete: Cascade)

  @@unique([plan_id, feature_key])
}

model Subscription {
  id                        String    @id @default(cuid())
  user_id                   String    @unique
  plan_id                   String
  status                    String    @default("active")  // active, cancelled, expired, past_due
  started_at                DateTime  @default(now())
  expires_at                DateTime?
  cancelled_at              DateTime?
  billing_cycle             String    @default("monthly")
  provider_subscription_id  String?
  current_period_start      DateTime  @default(now())
  current_period_end        DateTime?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  user    User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan    Plan  @relation(fields: [plan_id], references: [id])
  payments Payment[]
}

model UserUsage {
  id              String   @id @default(cuid())
  user_id         String   @unique
  resume_count    Int      @default(0)
  cover_letter_count Int   @default(0)
  ai_requests     Int      @default(0)
  resume_reviews  Int      @default(0)
  exports_count   Int      @default(0)
  ats_checks      Int      @default(0)
  job_applications_count Int @default(0)
  updated_at      DateTime @updatedAt
  created_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Payment {
  id                      String    @id @default(cuid())
  user_id                 String
  subscription_id         String?
  amount                  Int       // amount in cents
  currency                String    @default("USD")
  status                  String    @default("pending")  // pending, successful, failed, refunded
  transaction_reference   String?
  provider                String    @default("paystack")  // paystack (flutterwave for old payments)
  provider_transaction_id String?   @unique               // Paystack reference
  plan_id                 String?                         // plan and period that were bought
  billing_cycle           String?
  payment_method          String?
  paid_at                 DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscription_id], references: [id])
}

model Resume {
  id                  String   @id @default(cuid())
  user_id             String
  title               String   @default("Untitled Resume")
  data_json           String   @default("{}")           // Full resume data as JSON
  template            String   @default("ats-classic")  // Template ID
  customization_json  String   @default("{}")           // Template customization as JSON
  status              String   @default("draft")        // draft, completed
  plan_tier           String   @default("free")         // plan it was created on: free, pro (hidden on Free when pro)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  aiHistory AiHistory[]

  @@index([user_id])
  @@index([user_id, plan_tier])
}

model AiHistory {
  id            String   @id @default(cuid())
  resume_id     String
  user_id       String
  section       String                        // which resume section
  action        String                        // generate, rewrite, improve, etc.
  prompt        String                        // the full prompt sent to AI
  result        String                        // AI-generated content
  original_text String   @default("")          // text before AI modification
  is_applied    Boolean  @default(false)       // whether user applied the suggestion
  created_at    DateTime @default(now())

  resume Resume @relation(fields: [resume_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([resume_id])
  @@index([user_id])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id            String   @id @default(cuid())
  email         String   @unique
  language      String   @default("en")
  status        String   @default("active")
  subscribed_at DateTime @default(now())
  updated_at    DateTime @updatedAt
  source        String   @default("landing")
  created_at    DateTime @default(now())
}

model CoverLetter {
  id                    String   @id @default(cuid())
  user_id               String
  title                 String   @default("Untitled Cover Letter")
  data_json             String   @default("{}")
  template              String   @default("professional")
  customization_json    String   @default("{}")
  status                String   @default("draft")
  language              String   @default("en")
  plan_tier             String   @default("free")  // plan it was created on: free, pro (hidden on Free when pro)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  user     User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  versions CoverLetterVersion[]

  @@index([user_id])
  @@index([user_id, plan_tier])
}

model JobApplication {
  id                String    @id @default(cuid())
  user_id           String
  company_name      String
  job_title         String
  job_description   String?
  job_url           String?
  salary            String?
  location          String?
  employment_type   String?
  work_mode         String?
  resume_used       String?
  cover_letter_used String?
  notes             String?
  status            String    @default("wishlist")
  is_archived       Boolean   @default(false)
  applied_at        DateTime?
  interview_date    DateTime?
  follow_up_date    DateTime?
  deadline_date     DateTime?
  offer_expiry      DateTime?
  calendar_events   String    @default("[]")
  reminders         String    @default("[]")
  ai_suggestions    String    @default("[]")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

model CoverLetterVersion {
  id                 String   @id @default(cuid())
  cover_letter_id    String
  version_number     Int
  data_json          String   @default("{}")
  change_summary     String   @default("")
  created_at         DateTime @default(now())

  coverLetter CoverLetter @relation(fields: [cover_letter_id], references: [id], onDelete: Cascade)

  @@unique([cover_letter_id, version_number])
  @@index([cover_letter_id])
}

model Notification {
  id         String    @id @default(cuid())
  user_id    String
  type       String // e.g. "job_status"
  data       String    @default("{}") // JSON: what happened; the text is translated in the app
  link       String?
  read_at    DateTime?
  created_at DateTime  @default(now())
  // Set for automatic notifications so the same event is only reported once
  dedupe_key String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, dedupe_key])
  @@index([user_id, created_at])
}

// Requests from organisations interested in Enterprise (Contact Sales form)
model EnterpriseLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String
  org_type     String   // university, school, training, agency, ngo, government, company, other
  team_size    String   // 1-25, 26-100, 101-500, 500+
  country      String?
  phone        String?
  message      String   @default("")
  locale       String   @default("en")
  status       String   @default("new") // new, contacted, won, lost
  user_id      String?  // signed-in user who sent it, if any
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([status, created_at])
}

// Enterprise customer. Its members get the Enterprise plan while it is
// active and not past ends_at, up to `seats` members.
model Organization {
  id                  String    @id @default(cuid())
  name                String
  org_type            String    @default("other")
  seats               Int
  status              String    @default("active") // active, suspended
  ends_at             DateTime?
  invite_code         String    @unique // shareable join link: /join/<invite_code>
  invite_link_enabled Boolean   @default(true)
  lead_id             String?   // EnterpriseLead it came from, if any
  // Branding shown to members
  brand_color           String?   // #RRGGBB, replaces the Hassify blue
  logo                  Bytes?    // PNG / JPEG / WebP, at most 300 KB
  logo_mime             String?
  logo_updated_at       DateTime?
  recommended_templates String    @default("[]") // JSON array of up to 3 template ids
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  members  OrganizationMember[]
  invites  OrganizationInvite[]
  invoices OrganizationInvoice[]
}

// A person can belong to one organisation at a time
model OrganizationMember {
  id              String   @id @default(cuid())
  organization_id String
  user_id         String   @unique
  role            String   @default("member") // owner, admin, member
  joined_at       DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([organization_id])
}

// Personal invite for one email address (/join/<token>); removed once used
model OrganizationInvite {
  id              String   @id @default(cuid())
  organization_id String
  email           String
  role            String   @default("member")
  token           String   @unique
  invited_by      String?
  expires_at      DateTime
  created_at      DateTime @default(now())

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)

  @@unique([organization_id, email])
  @@index([email])
}

// Payment request for an organisation's seats, paid through /pay/<token>.
// Paying sets the seats and adds the months to the organisation's end date.
model OrganizationInvoice {
  id                String    @id @default(cuid())
  organization_id   String?   // kept as a record (null) if the organisation is deleted
  organization_name String
  seats             Int
  months            Int
  unit_price        Int       // per seat per month, in the currency's subunit (x100)
  amount            Int       // total: seats x months x unit_price
  currency          String
  note              String    @default("")
  token             String    @unique
  status            String    @default("open") // open, paid, cancelled
  reference         String?   @unique // Paystack reference once paid
  payer_email       String?
  payment_method    String?
  paid_at           DateTime?
  access_until      DateTime? // organisation's end date after this payment
  created_by        String?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  organization Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
}

// What site admins did (organisations, payments, requests) and admin
// sign-ins. Written by the app only; never edited.
model AdminAuditLog {
  id          String   @id @default(cuid())
  actor_id    String?
  actor_email String
  action      String   // e.g. org.create, org.delete, invoice.create, admin.signin
  target_type String?  // organization, invoice, lead
  target_id   String?
  summary     String   @default("") // short human-readable details, e.g. the organisation's name
  ip          String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([created_at])
}
